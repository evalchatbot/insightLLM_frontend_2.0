import { createClient } from '@supabase/supabase-js';
import { getAuth, clerkClient } from '@clerk/nextjs/server';
import { NextResponse } from 'next/server';

export const dynamic = 'force-dynamic';

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!
);

export async function GET(req: Request) {
  try {
    const { userId } = getAuth((req as any) as any);
    if (!userId) {
      return NextResponse.json({ success: false, message: 'Unauthorized' }, { status: 401 });
    }

    // Get Clerk user to extract email
    let userEmail: string | null = null;
    try {
      const client = await clerkClient();
      const clerkUser = await client.users.getUser(userId);
      if (clerkUser?.emailAddresses && clerkUser.emailAddresses.length > 0) {
        userEmail = clerkUser.emailAddresses[0].emailAddress;
      }
    } catch (e) {
      console.error('Failed to fetch Clerk user:', e);
      return NextResponse.json({ success: false, message: 'Authentication error' }, { status: 401 });
    }

    if (!userEmail) {
      return NextResponse.json({ success: false, message: 'No email found for user' }, { status: 400 });
    }

    // Find Supabase user by email
    const { data: supUser, error: supUserErr } = await supabase
      .from('users')
      .select('id')
      .eq('email', userEmail)
      .single();

    if (supUserErr || !supUser) {
      return NextResponse.json({ success: false, message: 'No matching Supabase user' }, { status: 404 });
    }

    // Get current period
    const currentPeriod = new Date().toISOString().slice(0, 7) + '-01';

    // Check for pro access
    const { data: keyData } = await supabase
      .from('keys')
      .select('expiry_date')
      .eq('used_by', supUser.id)
      .eq('is_used', true)
      .order('expiry_date', { ascending: false })
      .limit(1)
      .single();

    const isPro = keyData && new Date(keyData.expiry_date) > new Date();
    const tableName = isPro ? 'usage_pro' : 'usage_free';

    // Ensure usage record exists for current period
    await supabase.from(tableName).upsert({
      user_id: supUser.id,
      period_start: currentPeriod,
      tokens_input_used: 0,
      tokens_output_used: 0,
      pages_used: 0
    }, {
      onConflict: 'user_id,period_start',
      ignoreDuplicates: true
    });

    // Get current usage
    const { data: usage } = await supabase
      .from(tableName)
      .select('*')
      .eq('user_id', supUser.id)
      .eq('period_start', currentPeriod)
      .single();

    // Define usage limits
    const limits = isPro ? {
      input_tokens: 1000000,   // 1M tokens for Pro
      output_tokens: 3000000,  // 3M tokens for Pro
      pages: 1000             // 1K pages for Pro
    } : {
      input_tokens: 250000,    // 0.25M tokens for Free
      output_tokens: 500000,   // 0.5M tokens for Free
      pages: 50               // 50 pages for Free
    };

    // Format response
    const response = {
      success: true,
      hasAccess: isPro,
      isPro,
      usage: usage ? {
        tokens_input: usage.tokens_input_used || 0,
        tokens_output: usage.tokens_output_used || 0,
        pages: usage.pages_used || 0,
        period_start: usage.period_start
      } : null,
      limits
    };

    // Add pro-specific fields
    if (isPro && keyData) {
      const daysLeft = Math.max(
        0,
        Math.ceil(
          (new Date(keyData.expiry_date).getTime() - new Date().getTime()) /
          (1000 * 60 * 60 * 24)
        )
      );
      Object.assign(response, {
        daysLeft,
        end_date: keyData.expiry_date
      });
    }

    return NextResponse.json(response);

  } catch (err) {
    console.error('Error in pro status route:', err);
    return NextResponse.json({ 
      success: false, 
      message: 'Server error',
      details: err instanceof Error ? err.message : 'Unknown error'
    }, { status: 500 });
  }
}