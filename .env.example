# Example environment variables for Next.js frontend (no real secrets)
# Copy to .env.local and fill with your values. Keep .env.local untracked.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ANON_PUBLIC_KEY_PLACEHOLDER

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=CLERK_PUBLISHABLE_KEY_PLACEHOLDER
CLERK_SECRET_KEY=CLERK_SECRET_KEY_PLACEHOLDER

# Server-only keys
SUPABASE_SERVICE_ROLE_KEY=SERVICE_ROLE_KEY_PLACEHOLDER
JWT_SECRET_KEY=JWT_SECRET_PLACEHOLDER

# Backend API URL (REQUIRED for production deployment)
# Local: http://localhost:8000
# Production: https://your-backend-url.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
