{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "react/no-unescaped-entities": "off",
    "prefer-const": "off",
    "@typescript-eslint/no-empty-interface": "off",
    "@typescript-eslint/ban-types": "off",
    "@typescript-eslint/no-empty-function": "off",
    "react/display-name": "off",
    "@typescript-eslint/no-empty-object-type": "off",
    "import/no-anonymous-default-export": "off",
    "react-hooks/exhaustive-deps": "off",
    // CI lint gate: correctness rules (e.g. react-hooks/rules-of-hooks) stay errors.
    // This one is a navigation-performance hint (<a href="/"> instead of <Link>) with a
    // single pre-existing hit in app/factbook/page.tsx; kept visible as a warning.
    // `npm run lint` also caps warnings (--max-warnings) so new ones fail CI.
    "@next/next/no-html-link-for-pages": "warn"
  }
}
