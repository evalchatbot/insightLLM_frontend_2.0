# Example environment for the standalone "Evaluations + Fact Book" app.
# Copy to .env.local and fill in. Keep .env.local untracked. No real secrets here.
#
# This build has NO Clerk / no Supabase auth — access is a single hardcoded login.

# REQUIRED: the live FastAPI backend (same one production uses). No trailing slash.
# Falls back to http://localhost:8000 if blank.
NEXT_PUBLIC_API_BASE_URL=https://your-backend-url.com

# Hardcoded single login (server-side only; never sent to the browser).
APP_USERNAME=admin
APP_PASSWORD=changeme
APP_SESSION_TOKEN=change-me-to-a-long-random-string

# OPTIONAL: set both to persist Feedback-widget submissions to Supabase.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SERVICE_ROLE_KEY_PLACEHOLDER
